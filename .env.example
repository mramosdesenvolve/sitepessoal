# Postgres — Vercel Postgres, Supabase, Neon ou qualquer provedor com
# connection string padrão. Ver README para instruções de setup.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Senha do painel /admin — escolha algo forte, isso protege quem pode
# publicar conteúdo no site.
ADMIN_PASSWORD="troque-esta-senha"

# Segredo usado para assinar o cookie de sessão do admin. Gere um valor
# aleatório, ex.: openssl rand -base64 32
SESSION_SECRET="troque-este-segredo"
